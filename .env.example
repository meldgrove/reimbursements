# Local development (docs/development.md). Start the services first:
#   docker compose -f compose.dev.yaml up -d
# then: cp .env.example .env && npm ci && npm run db:migrate && npm run dev
# Every value here is for development only.
NODE_ENV=development
DEPLOYMENT_ENV=development
DATABASE_URL=postgresql://reimbursement:reimbursement@127.0.0.1:55468/reimbursement
# The web app runs on Vite (npm run dev); the API on port 8000 behind it.
APP_URL=http://localhost:5173
PORT=8000
AUTH_SECRET=development-only-replace-with-a-random-secret-of-50-characters
HEALTHCHECK_TOKEN=local-development-health-token
# Receipts, PDFs and the worker heartbeat; var/private in the repository when unset.
# PRIVATE_STORAGE_ROOT=

# Sign-in with the development Keycloak (realm "reimbursements"):
#   admin@example.invalid / admin is a template admin, editor@example.invalid / editor a form editor.
KEYCLOAK_BASE_URL=http://localhost:8106
KEYCLOAK_REALM=reimbursements
OIDC_CLIENT_ID=reimbursements
OIDC_CLIENT_SECRET=reimbursements-dev-client-secret
KEYCLOAK_ADMIN_GROUP=/reimbursements/admins
KEYCLOAK_EDITOR_GROUP=/reimbursements/editors
# Development sign-in without Keycloak: `npm run cli -- create-superuser --username dev`, then
# sign in at /admin/login.
# DEV_LOGIN=1

# Local mode writes private .eml files under PRIVATE_STORAGE_ROOT and sends nothing,
# whatever Admin > Email says. "send" sends with the provider set up there.
MAIL_DELIVERY_MODE=local
MAILERSEND_API_TOKEN=
MAILERSEND_WEBHOOK_SIGNING_SECRET=
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_REPLY_TO_ADDRESS=finance@example.invalid
APPROVED_DELIVERY_RECIPIENTS=finance@example.invalid
TEST_RECIPIENT_ALLOWLIST=

# ClamAV: `docker compose -f compose.dev.yaml --profile scanner up -d`, then clamav and 127.0.0.1.
UPLOAD_SCANNER=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# The document sandbox needs Linux with Landlock and the built add-on (npm run build:sandbox
# in apps/server). Without it, development reads files unconfined.
DOCUMENT_SANDBOX_ENABLED=0
REQUIRE_WORKER_HEARTBEAT=0

# Only proxy networks that replace or append X-Forwarded-For correctly.
TRUSTED_PROXY_CIDRS=

# Deployment identity: the footer of public pages.
PORTAL_OPERATOR=
PORTAL_LEGAL_URL=

# Optional error reports to Sentry or a compatible service; off while SENTRY_DSN is empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# In-app updates (docs/updates.md): the updater the template admins' update button talks to.
# Empty here: no update button. Without the line: http://updater:8080.
UPDATER_URL=

# Meldgrove Backups (docs/deployment.md#backups): the two lines Backups shows when the app is
# added as a source. Without them, the backup agent idles.
# BACKUP_URL=https://backups.example.invalid
# BACKUP_TOKEN=
