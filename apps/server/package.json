{
  "name": "@reimbursements/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/instrument.ts --clear-screen=false src/main.ts",
    "build": "node scripts/build.mjs && node ../../scripts/inject-debug-ids.mjs dist",
    "build:sandbox": "node native/sandbox/build.mjs && node scripts/build-file-worker.mjs",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "APP_ROLE=migrate tsx --env-file-if-exists=../../.env src/main.ts",
    "worker": "APP_ROLE=worker tsx --env-file-if-exists=../../.env --import ./src/instrument.ts src/main.ts",
    "cli": "tsx --env-file-if-exists=../../.env --import ./src/instrument.ts src/cli.ts"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@fastify/busboy": "3.2.6",
    "@hono/node-server": "2.1.8",
    "@reimbursements/shared": "*",
    "@sentry/node": "11.12.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "openid-client": "6.9.0",
    "pdf-lib": "1.17.1",
    "pdfmake": "0.3.15",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pdfmake": "0.3.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
