# Production settings for compose.yaml on a Linux server (docs/deployment.md):
#   cp .env.production.example .env && chmod 600 .env
# Replace every REPLACE_WITH value. On Coolify, paste it into the environment editor's
# Developer view instead (docs/coolify.md).
# The release to run: a series such as 0.3 for its newest release, or an exact version.
# With automatic updates, the server writes each version it installs here
# (docs/updates.md).
REIMBURSEMENTS_VERSION=0.6
DEPLOYMENT_ENV=production
# Signs sessions and seals the secrets entered under Admin > Email (AUTH_SECRET is the
# same setting under its new name and wins when both are set). Keep it apart from the
# backups: a restore needs it.
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
# The complete URL of your PostgreSQL: scheme, credentials, hostname, port and database
# name. localhost would be the container itself.
DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_DATABASE_HOST:5432/REPLACE_WITH_DATABASE_NAME
# Or a PostgreSQL next to the app (compose.postgres.yaml): uncomment these three lines
# and remove the DATABASE_URL above.
# COMPOSE_FILE=compose.yaml:compose.postgres.yaml
# POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
# DATABASE_URL=postgresql://reimbursements:REPLACE_WITH_RANDOM_HEX_PASSWORD@postgres:5432/reimbursements
HEALTHCHECK_TOKEN=REPLACE_WITH_RANDOM_HEALTH_CHECK_TOKEN
# The public HTTPS address. Sign-in sends the provider back to its first https origin
# without a wildcard; every origin listed may send changes. With several addresses, also
# set APP_URL to the one registered as the redirect URI. ALLOWED_HOSTS of the Django
# version is no longer read (0.4's compose.yaml needs it if you go back).
CSRF_TRUSTED_ORIGINS=https://reimbursements.example.invalid
# APP_URL=https://reimbursements.example.invalid
# Where the reverse proxy's requests come from; never 0.0.0.0/0. On a server: the
# gateway of the app's Docker network with /32 (docs/deployment.md, Set up, step 6).
TRUSTED_PROXY_CIDRS=REPLACE_WITH_ACTUAL_PROXY_NETWORK_CIDRS

# Configure your own Keycloak instance and realm below (KEYCLOAK_BASE_URL and KEYCLOAK_REALM
# further down), or any OpenID Connect provider with OIDC_ISSUER instead.
# Redirect URI: https://reimbursements.example.invalid/oidc/callback/
# Post logout: https://reimbursements.example.invalid/*
OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
# Groups (full path) granting template admin and form editor rights.
KEYCLOAK_ADMIN_GROUP=/reimbursements/admins
KEYCLOAK_EDITOR_GROUP=/reimbursements/editors
# With OIDC_ISSUER: the ID token claim that lists the groups, if it is not "groups".
# OIDC_GROUPS_CLAIM=groups

# Email (MailerSend or an SMTP server), the operator's name and the legal page are set
# after the start under Admin > Email and Admin > General, or with `cli settings`
# (docs/deployment.md, Operator commands); they are not set here.
# Every inbox a form may send to. Admins choose one of these per form.
APPROVED_DELIVERY_RECIPIENTS=REPLACE_WITH_ALL_APPROVED_DELIVERY_INBOXES
# Required and nonempty when DEPLOYMENT_ENV=staging.
TEST_RECIPIENT_ALLOWLIST=

# Capacity and retention defaults. Tune after measuring on the deployment host.
TOTAL_WEB_WORKERS=2
MAX_ACTIVE_DRAFTS=10000
MAX_DRAFTS_PER_NETWORK=300
MAX_UPLOADS_PER_NETWORK=5000
MAX_UPLOADS_PER_NETWORK_PER_MINUTE=1000
MAX_UPLOAD_BYTES_PER_NETWORK=15000000000
MAX_PENDING_VALIDATIONS=1000
MAX_JOB_AGE_SECONDS=900
MAX_FINAL_PDF_BYTES=10000000
MIN_FREE_STORAGE_BYTES=1000000000
JOB_TIMEOUT_SECONDS=240

KEYCLOAK_BASE_URL=https://auth.example.invalid
KEYCLOAK_REALM=reimbursements

# Optional error reports to Sentry or a compatible service; off while SENTRY_DSN is empty.
# SENTRY_ENVIRONMENT defaults to DEPLOYMENT_ENV. SENTRY_RELEASE names the deployed version;
# release images default it to reimbursements@<version>.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Automatic updates by the updater service (docs/updates.md): off until the server runs
# `updater host-setup`, which then sets REIMBURSEMENTS_VERSION to the exact version it
# installs. On Coolify, add UPDATE_DEPLOY_HOOK_URL and UPDATE_DEPLOY_HOOK_TOKEN
# (docs/coolify.md).
# A release installs once it has been out this long (3d, 12h, 0 for at once), and only
# inside the window, if one is set: two times of day in the time zone TZ (default UTC).
UPDATE_COOLDOWN=3d
UPDATE_WINDOW=
# The updater's API for the template admins' update button. compose.yaml uses
# http://updater:8080 when this is empty.
UPDATER_URL=http://updater:8080
# Recommended: a token the app sends and the updater then requires, so that nothing
# else on the app's network can ask it to install. Make one with: openssl rand -hex 32.
# Empty: the updater takes requests without a token, as before.
UPDATER_TOKEN=

# Meldgrove Backups (docs/deployment.md#backups): the two values Backups shows
# when the app is added as a source. Empty: the backup agent idles.
BACKUP_URL=
BACKUP_TOKEN=
