{
  "name": "reimbursements",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @reimbursements/server & npm run dev --workspace @reimbursements/web & wait",
    "dev:server": "npm run dev --workspace @reimbursements/server",
    "dev:web": "npm run dev --workspace @reimbursements/web",
    "dev:worker": "npm run worker --workspace @reimbursements/server",
    "build": "npm run build --workspace @reimbursements/web && npm run build --workspace @reimbursements/server",
    "start": "npm run start --workspace @reimbursements/server",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @reimbursements/server",
    "db:generate": "npm run db:generate --workspace @reimbursements/server",
    "db:migrate": "npm run db:migrate --workspace @reimbursements/server",
    "cli": "npm run cli --workspace @reimbursements/server --",
    "check:public": "node scripts/check-public-repository.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@meldgrove/ui": "^0.1.9",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "sentry": "0.49.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
