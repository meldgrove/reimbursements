# compose.yaml: the whole application as one Coolify resource.
# Paste into Coolify > Environment Variables > Developer view.
# Replace every REPLACE_WITH value. Keep secrets available at runtime only.
DEPLOYMENT_ENV=production
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
# Copy the complete Postgres URL (internal) from the separate Coolify database.
# Includes scheme, credentials, hostname, port and database name.
DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_COOLIFY_DATABASE_HOST:5432/REPLACE_WITH_DATABASE_NAME
HEALTHCHECK_TOKEN=REPLACE_WITH_RANDOM_HEALTH_CHECK_TOKEN
ALLOWED_HOSTS=reimbursements.example.invalid,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://reimbursements.example.invalid
# Use only the actual reverse proxy network CIDRs; never 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=REPLACE_WITH_ACTUAL_PROXY_NETWORK_CIDRS

# Configure your own Keycloak instance and realm below.
# Redirect URI: https://reimbursements.example.invalid/oidc/callback/
# Post logout: https://reimbursements.example.invalid/*
OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
# Groups (full path) granting template admin and form editor rights.
KEYCLOAK_ADMIN_GROUP=/reimbursements/admins
KEYCLOAK_EDITOR_GROUP=/reimbursements/editors

MAILERSEND_API_TOKEN=REPLACE_WITH_MAILERSEND_API_TOKEN
# For the first deployment, use a temporary random value if no webhook exists.
# Replace it with MailerSend's actual signing secret before accepting claims.
MAILERSEND_WEBHOOK_SIGNING_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
# Every inbox a form may send to. Admins choose one of these per form.
APPROVED_DELIVERY_RECIPIENTS=REPLACE_WITH_ALL_APPROVED_DELIVERY_INBOXES
# Required and nonempty when DEPLOYMENT_ENV=staging.
TEST_RECIPIENT_ALLOWLIST=

# Capacity and retention defaults. Tune after measuring on the deployment host.
TOTAL_WEB_WORKERS=2
MAX_ACTIVE_DRAFTS=10000
MAX_DRAFTS_PER_NETWORK=300
MAX_UPLOADS_PER_NETWORK=5000
MAX_UPLOADS_PER_NETWORK_PER_MINUTE=1000
MAX_UPLOAD_BYTES_PER_NETWORK=15000000000
MAX_PENDING_VALIDATIONS=1000
MAX_JOB_AGE_SECONDS=900
MAX_FINAL_PDF_BYTES=10000000
MIN_FREE_STORAGE_BYTES=1000000000
JOB_TIMEOUT_SECONDS=240

# Deployment identity. No organisation-specific defaults are shipped.
PORTAL_OPERATOR=
PORTAL_LEGAL_URL=
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_REPLY_TO_ADDRESS=finance@example.invalid
KEYCLOAK_BASE_URL=https://auth.example.invalid
KEYCLOAK_REALM=reimbursements

# Optional error reports to Sentry or a compatible service; off while SENTRY_DSN is empty.
# SENTRY_ENVIRONMENT defaults to DEPLOYMENT_ENV. SENTRY_RELEASE names the deployed version;
# release images default it to reimbursements@<version>.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
