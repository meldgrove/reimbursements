# Fake but valid settings for the compose files of the newest release
# (meldgrove/.github compose-compat.yml). Nothing here is a real secret.
# DJANGO_SECRET_KEY, as .env.production.example names it. With AUTH_SECRET alone,
# Compose 2.x (as on GitHub's runners) still requires compose.yaml's fallback. The
# compose files on main have no :? inside it: once a release after 0.5.1 has them on
# stable, AUTH_SECRET alone works here too.
DJANGO_SECRET_KEY=compat-only-not-a-secret-compat-only-not-a-secret-0001
APP_URL=https://reimbursements.example.invalid
POSTGRES_PASSWORD=compat-only-password
DATABASE_URL=postgresql://reimbursements:compat-only-password@postgres:5432/reimbursements
TRUSTED_PROXY_CIDRS=172.16.0.0/12
HEALTHCHECK_TOKEN=compat-only-health-token
KEYCLOAK_BASE_URL=https://sso.example.invalid
KEYCLOAK_REALM=reimbursements
OIDC_CLIENT_ID=reimbursements
OIDC_CLIENT_SECRET=compat-only
APPROVED_DELIVERY_RECIPIENTS=finance@example.invalid
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_REPLY_TO_ADDRESS=finance@example.invalid
MAILERSEND_API_TOKEN=compat-only
MAILERSEND_WEBHOOK_SIGNING_SECRET=compat-only
